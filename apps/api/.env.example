# UDYOG MARG Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/udyog_marg?schema=public"

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET="udyog-marg-secret-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="udyog-marg-refresh-secret-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Redis (Optional - for production Socket.IO scaling)
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# AI APIs (Optional - app works without these using RAG-only mode)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Get from: https://console.groq.com/
GROQ_API_KEY=""
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=""

# Cloudinary (for file uploads - optional, uses local disk if not set)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# OTP Configuration
OTP_EXPIRY_MINUTES=10
DEMO_OTP="123456"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/jpg,image/png,image/webp"

# Logging
LOG_LEVEL="info"
LOG_DIR="./logs"
